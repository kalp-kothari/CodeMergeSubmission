generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  REJECTED
  WITHDRAWN
}

model Event {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  rounds      Round[]
  teams       Team[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("events")
}

model Round {
  id                 String       @id @default(cuid())
  eventId            String       @map("event_id")
  event              Event        @relation(fields: [eventId], references: [id])
  name               String
  slug               String
  submissionOpen     DateTime     @map("submission_open")
  submissionDeadline DateTime     @map("submission_deadline")
  allowedFileTypes   String[]     @map("allowed_file_types")
  maxFileSize        Int          @map("max_file_size")
  domains            String[]
  submissions        Submission[]
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@unique([eventId, slug])
  @@map("rounds")
}

model Team {
  id          String       @id @default(cuid())
  eventId     String       @map("event_id")
  event       Event        @relation(fields: [eventId], references: [id])
  teamName    String       @map("team_name")
  isEligible  Boolean      @default(true) @map("is_eligible")
  submissions Submission[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([eventId, teamName])
  @@index([eventId])
  @@map("teams")
}

model Submission {
  id               String           @id @default(cuid())
  submissionId     String           @unique @map("submission_id")
  sequenceNumber   Int              @map("sequence_number")
  roundId          String           @map("round_id")
  round            Round            @relation(fields: [roundId], references: [id])
  teamId           String           @map("team_id")
  team             Team             @relation(fields: [teamId], references: [id])

  leaderEmail      String           @map("leader_email")
  leaderContact    String           @map("leader_contact")

  domain           String
  problemStatement String           @map("problem_statement")
  solutionSummary  String           @map("solution_summary")

  fileName         String           @map("file_name")
  fileType         String           @map("file_type")
  fileSize         Int              @map("file_size")
  storagePath      String           @map("storage_path")

  status           SubmissionStatus @default(SUBMITTED)

  submittedAt      DateTime         @default(now()) @map("submitted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([teamId, roundId])
  @@index([roundId])
  @@index([submissionId])
  @@index([leaderEmail])
  @@index([status])
  @@index([domain])
  @@index([submittedAt])
  @@map("submissions")
}
